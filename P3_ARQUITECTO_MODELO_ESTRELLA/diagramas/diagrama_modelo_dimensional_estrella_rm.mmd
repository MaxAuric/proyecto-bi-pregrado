        float tasa_ocupacion_inst_anual_pct "Ocupación anual institucional %"
        float tasa_programas_sobredemanda_inst_pct "Carreras con sobrecupo %"
        float cuota_mercado_matricula_rm_pct "Market Share matrícula RM %"
