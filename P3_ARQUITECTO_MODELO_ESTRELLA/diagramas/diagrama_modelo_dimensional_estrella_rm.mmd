        string nivel_saturacion_sede "1. Saturada | 2. Equilibrio | 3. Ociosa"
    }

    DIM_INSTITUCION_SIES {
        int id_institucion_sk PK "Surrogate Key SCD Tipo 2 (1.298 fotos)"
        int codigo_ies_sies "Código oficial SIES / MINEDUC"
