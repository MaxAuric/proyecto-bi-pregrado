   <Row ss:Height="24">
    <Cell ss:StyleID="RowEven"><Data ss:Type="Number">57</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">tasa_ocupacion_primer_ano</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">DECIMAL(6,2)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Métrica Analítica / Ratio Intensivo</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">((matricula_primer_ano_total / vacantes) * 100). Calculado solo cuando flag_vacantes_declaradas = 1.</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Preservado como NULL cuando no hay vacantes declaradas para no sesgar medias.</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowOdd"><Data ss:Type="Number">58</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">ratio_mujeres_primer_ano</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">DECIMAL(5,2)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Métrica Analítica / Ratio Intensivo</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">((matricula_primer_ano_mujeres / matricula_primer_ano_total) * 100).</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Preservado como NULL si matricula_primer_ano_total == 0.</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowEven"><Data ss:Type="Number">59</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">ratio_extranjeros_total</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">(Calculado)</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">DECIMAL(5,2)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Métrica Analítica / Ratio Intensivo</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">((matricula_total_extranjeros / matricula_total) * 100).</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Preservado como NULL si matricula_total == 0.</Data></Cell>
   </Row>
  </Table>
